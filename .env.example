# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to \`.env\`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# Use this URL when running Next.js on the host with Compose Postgres.
# For another instance, use that server's connection string.
POSTGRES_URL="postgres://custa:custa-local@localhost:5432/custa"


# You can generate the secret via 'openssl rand -base64 32' on Unix
# @see https://www.better-auth.com/docs/installation
AUTH_SECRET=''

# Browser-facing origin for your instance, including http:// or https://.
PROJECT_PRODUCTION_URL='http://localhost:3000'

# Optional social sign-in for owners of the Next.js workspace.
AUTH_GOOGLE_CLIENT_ID=''
AUTH_GOOGLE_CLIENT_SECRET=''
AUTH_APPLE_CLIENT_ID=''
AUTH_APPLE_CLIENT_SECRET=''
AUTH_LINKEDIN_CLIENT_ID=''
AUTH_LINKEDIN_CLIENT_SECRET=''

# Server-only settings for the Custa sales workflow.
SALES_MCP_URL=''
SALES_MCP_TOKEN=''
SALES_PUBLIC_URL=''
